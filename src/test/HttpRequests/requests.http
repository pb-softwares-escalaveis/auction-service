### Variáveis Globais
@baseUrl = http://localhost:8080
@user1 = bddfe29d-3bd1-47e5-bf4b-03a50c65d534
@user2 = 51bd71ce-a60e-40cb-84ff-998688f9acdb
#BLOQUEADO FAZ NADA
@user3 = 64c58708-95cf-4859-aa16-bf1c6c880f7e

---
### criar anuncio usuario 1

POST {{baseUrl}}/auctions/create
X-User-Id: {{user1}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="data"
Content-Type: application/json

{
  "title": "Pen Drive de Barata 12KB",
  "description": "Sobrevive ao apocalipse nuclear muito novo",
  "category": "ELECTRONICS",
  "initialBidPrice": 10.00,
  "buyNowPrice": 200.00,
  "durationInDays": 3
}
--WebAppBoundary
Content-Disposition: form-data; name="image"; filename="pen_drive_barata.jpg"
Content-Type: image/jpeg

< ./images/pen_drive_barata.jpg
--WebAppBoundary--

### criar  anuncio usuario 1 sem buyNowPrice

POST {{baseUrl}}/auctions/create
X-User-Id: {{user1}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="data"
Content-Type: application/json

{
  "title": "Olhos Escarlate",
  "description": "Removidos de vítimas do massacre ao clã Kurta pela Troupe Fantasma.",
  "initialBidPrice": 100000.00,
  "category": "COLLECTIBLES_AND_ART",
  "durationInDays": 7
}
--WebAppBoundary
Content-Disposition: form-data; name="image"; filename="olhos-escarlate.jpg"
Content-Type: image/jpeg

< ./images/olhos-escarlate.jpg
--WebAppBoundary--

### criar anuncio com usuario 2 e sem buyNowPrice

POST {{baseUrl}}/auctions/create
X-User-Id: {{user2}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="data"
Content-Type: application/json

{
	"title": "LP Leno Brega 1989",
	"description": "LP DISCO DE VINIL LENO BREGA - VOLUME 2, BOM ESTADO GERAL!!!",
	"initialBidPrice": 200.00,
	"category": "MUSIC",
	"durationInDays": 7
}

--WebAppBoundary
Content-Disposition: form-data; name="image"; filename="./images/leno.jpg"
Content-Type: image/jpeg

< ./images/leno.jpg
--WebAppBoundary--

