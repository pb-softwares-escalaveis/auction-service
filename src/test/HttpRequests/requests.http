### anuncio com usuario bloqueado

POST {{baseUrl}}/auctions/create
X-User-Id: {{user3}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="data"
Content-Type: application/json

{
  "title": "Produto do Usuário Bloqueado",
  "description": "Não deve ser salvo",
  "initialBidPrice": 100.00,
  "category": "OTHER",
  "durationInDays": 3
}
--WebAppBoundary
Content-Disposition: form-data; name="image"; filename="leno.jpg"
Content-Type: image/jpeg

< ./images/leno.jpg
--WebAppBoundary--

### listar todos

GET {{baseUrl}}/auctions


### buscar um

GET {{baseUrl}}/auctions/1


### dar lance no proprio anuncio

POST {{baseUrl}}/auctions/1/bids
X-User-Id: {{user1}}
Content-Type: application/json

{
  "amount": 1000.00
}


### dar lance valido

POST {{baseUrl}}/auctions/1/bids
X-User-Id: {{user3}}
Content-Type: application/json

{
  "amount": 1000.00
}


### dar lance abaixo de 5%

POST {{baseUrl}}/auctions/1/bids
X-User-Id: {{user2}}
Content-Type: application/json

{
  "amount": 1001.00
}

### dar lance valido com arremate

POST {{baseUrl}}/auctions/1/bids
X-User-Id: {{user3}}
Content-Type: application/json

{
  "amount": 5000.00
}


### dono remove o anuncio

DELETE {{baseUrl}}/auctions/1
X-User-Id: {{user1}}
